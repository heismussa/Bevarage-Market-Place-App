# Copy this file to .env and replace every placeholder before starting the stack.
# Never commit the real .env file.

# Django. SECRET_KEY also signs JWTs, so use at least 50 random characters.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# PostgreSQL. Keep POSTGRES_PASSWORD and the password inside DATABASE_URL identical.
# Host "db" is the Compose service name.
POSTGRES_DB=beverage
POSTGRES_USER=beverage
POSTGRES_PASSWORD=replace-with-a-database-password
DATABASE_URL=postgres://beverage:replace-with-a-database-password@db:5432/beverage

# CORS (comma-separated origins, no spaces)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Used only by: python manage.py seed_demo
DEMO_ADMIN_PASSWORD=replace-with-admin-password
DEMO_CUSTOMER_PASSWORD=replace-with-customer-password
DEMO_STORE_OWNER_PASSWORD=replace-with-store-owner-password
