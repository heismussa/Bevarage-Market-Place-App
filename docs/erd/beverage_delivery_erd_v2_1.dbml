// =====================================================================
// Beverage Delivery Marketplace — ERD v2.1 (DBML)  [backend-ready]
// Paste into https://dbdiagram.io/d to render the diagram.
//
// DESIGN DECISIONS BAKED IN (change them here if the team decides otherwise)
//  1. Stock lives on products.stock_quantity ONLY (no STORE_STOCK table).
//  2. One cart = one store (carts.store_id); clear cart when switching stores.
//  3. MVP ends at READY -> COMPLETED (store hands off). ASSIGNED and
//     OUT_FOR_DELIVERY exist in the enum but are unused until Phase 10.
//  4. One central users table; customers / store_owners / drivers are profile
//     tables keyed by user_id. No separate admin table (role = ADMIN).
//  5. RBAC = users.role + DRF permission classes (no roles/permissions tables).
//  6. Payments are confirmed server-side via gateway webhook only.
//  7. Terminal order status is COMPLETED (used everywhere).
//  8. Selling unit is explicit: products.unit (BOTTLE/CAN/CRATE/CARTON/PACK);
//     products.price is the price PER that unit. (v2 wrongly assumed crates.)
//  9. Login identifier = phone. Email is optional.
// 10. Products are SOFT-deleted (deleted_at) because order history points to them.
// 11. Delivery fee source = stores.delivery_fee (copied onto orders at checkout).
// 12. Django mapping: users.password = Django's password field; Django adds
//     is_superuser/groups via PermissionsMixin. Do NOT create Driver/Delivery
//     models in the MVP - they stay in this file for planning only.
//
// Tables marked [v2] are designed now but built later (Phase 10+).
// =====================================================================

Project beverage_delivery_marketplace {
  database_type: 'PostgreSQL'
  Note: 'ERD v2.1 - MVP: Customer + Store Owner. Delivery/Driver designed for later.'
}

// ---------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------

Enum user_role {
  ADMIN
  CUSTOMER
  STORE_OWNER
  DRIVER
}

Enum store_status {
  OPEN
  CLOSED
}

Enum category_status {
  ACTIVE
  INACTIVE
}

Enum availability_status {
  AVAILABLE
  OUT_OF_STOCK
  UNAVAILABLE
}

Enum product_unit {
  BOTTLE
  CAN
  CRATE
  CARTON
  PACK
}

Enum order_status {
  PENDING
  ACCEPTED
  REJECTED
  PREPARING
  READY
  ASSIGNED          // unused in MVP
  OUT_FOR_DELIVERY  // unused in MVP
  COMPLETED
  CANCELLED
}

Enum payment_method {
  MPESA
  TIGO_PESA
  AIRTEL_MONEY
  CARD
  BANK
  CASH
}

Enum payment_status {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

Enum driver_status {
  AVAILABLE
  BUSY
  OFFLINE
  SUSPENDED
}

Enum delivery_status {
  ASSIGNED
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

Enum notification_type {
  ORDER_RECEIVED
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_PREPARING
  ORDER_READY
  ORDER_COMPLETED
  ORDER_CANCELLED
  DRIVER_ASSIGNED
  OUT_FOR_DELIVERY
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  LOW_STOCK
}

// ---------------------------------------------------------------------
// IDENTITY & ACCESS
// ---------------------------------------------------------------------

Table users {
  id            integer [pk, increment]
  full_name     varchar(100) [not null]
  phone         varchar(20)  [unique, not null, note: 'LOGIN IDENTIFIER (Django USERNAME_FIELD). Store in +255 format']
  email         varchar(100) [unique, note: 'OPTIONAL. NULL allowed (null=True, blank=True in Django)']
  password      varchar(128) [not null, note: 'Django hashed password - never plain text']
  role          user_role    [not null]
  is_active     boolean      [not null, default: true]
  is_staff      boolean      [not null, default: false, note: 'Required for Django Admin access']
  last_login    timestamp    [note: 'Required by Django AbstractBaseUser']
  created_at    timestamp    [not null, default: `now()`]
  updated_at    timestamp    [not null, default: `now()`]

  Note: 'Single authentication table for every role. Custom User model - set AUTH_USER_MODEL BEFORE the first migration.'
}

Table customers {
  user_id    integer [pk, ref: - users.id]
  created_at timestamp [not null, default: `now()`]

  Note: 'Profile for role = CUSTOMER. Exactly one per customer user.'
}

Table store_owners {
  user_id    integer [pk, ref: - users.id]
  created_at timestamp [not null, default: `now()`]

  Note: 'Profile for role = STORE_OWNER. One owner may own many stores.'
}

Table drivers {
  user_id        integer [pk, ref: - users.id]
  license_number varchar(50)  [unique, not null]
  vehicle_number varchar(30)  [not null]
  vehicle_type   varchar(30)  [not null]
  status         driver_status [not null, default: 'OFFLINE']
  created_at     timestamp [not null, default: `now()`]
  updated_at     timestamp [not null, default: `now()`]

  Note: '[v2] Profile for role = DRIVER. Built in Phase 10. Name/phone come from users.'
}

// ---------------------------------------------------------------------
// STORES & CATALOG
// ---------------------------------------------------------------------

Table stores {
  id          integer [pk, increment]
  owner_id    integer [not null, ref: > store_owners.user_id]
  store_name  varchar(100) [not null]
  description text
  logo_url    varchar(255)
  location    varchar(255) [not null]
  city        varchar(80)
  area        varchar(80)
  latitude    decimal(9,6)
  longitude   decimal(9,6)
  phone       varchar(20)  [not null]
  email       varchar(100)
  status      store_status [not null, default: 'CLOSED', note: 'OPEN / CLOSED toggle by owner']
  is_active   boolean      [not null, default: true, note: 'Admin can deactivate a store']
  delivery_fee decimal(12,2) [not null, default: 0, note: 'TZS. Copied to orders.delivery_fee at checkout']
  created_at  timestamp    [not null, default: `now()`]
  updated_at  timestamp    [not null, default: `now()`]

  indexes {
    owner_id
    (city, area)
  }

  Note: 'Customers can only order from stores where is_active = true AND status = OPEN.'
}

Table categories {
  id          integer [pk, increment]
  name        varchar(80) [unique, not null]
  slug        varchar(100) [unique, not null]
  description text
  status      category_status [not null, default: 'ACTIVE']
  created_at  timestamp [not null, default: `now()`]
  updated_at  timestamp [not null, default: `now()`]

  Note: 'Beer, Soft Drinks, Water, Energy Drinks, Juices, Wine, Spirits, Other.'
}

Table products {
  id                  integer [pk, increment]
  store_id            integer [not null, ref: > stores.id]
  category_id         integer [not null, ref: > categories.id]
  name                varchar(100) [not null]
  description         text
  image               varchar(255) [note: 'Django ImageField path (validate type and size)']
  unit                product_unit  [not null, note: 'What one price/stock unit means']
  price               decimal(12,2) [not null, note: 'TZS per unit. CHECK (price > 0)']
  stock_quantity      integer [not null, default: 0, note: 'In units of products.unit. CHECK (stock_quantity >= 0). SINGLE source of truth for stock']
  low_stock_threshold integer [not null, default: 5]
  availability_status availability_status [not null, default: 'AVAILABLE']
  deleted_at          timestamp [note: 'SOFT DELETE. NULL = active. Never hard-delete a product that appears in order_items']
  created_at          timestamp [not null, default: `now()`]
  updated_at          timestamp [not null, default: `now()`]

  indexes {
    (store_id, name) // enforce UNIQUE only WHERE deleted_at IS NULL (partial unique constraint)
    category_id
    availability_status
  }

  Note: 'Each store owns its own product rows. Stock is reduced inside the order transaction with row locking (select_for_update).'
}

// ---------------------------------------------------------------------
// CUSTOMER DATA: ADDRESSES & CART
// ---------------------------------------------------------------------

Table addresses {
  id           integer [pk, increment]
  customer_id  integer [not null, ref: > customers.user_id]
  address_name varchar(50)  [not null, note: 'Home, Office, University...']
  address_line varchar(255) [not null]
  city         varchar(80)  [not null]
  area         varchar(80)
  latitude     decimal(9,6)
  longitude    decimal(9,6)
  phone        varchar(20)  [not null]
  is_default   boolean      [not null, default: false]
  created_at   timestamp    [not null, default: `now()`]
  updated_at   timestamp    [not null, default: `now()`]

  indexes {
    customer_id
  }

  Note: 'Only one default per customer (enforce in service layer or partial unique index).'
}

Table carts {
  id          integer [pk, increment]
  customer_id integer [unique, not null, ref: - customers.user_id]
  store_id    integer [ref: > stores.id, note: 'Set on first item. NULL when cart is empty. All items must belong to this store']
  created_at  timestamp [not null, default: `now()`]
  updated_at  timestamp [not null, default: `now()`]

  Note: 'One active cart per customer.'
}

Table cart_items {
  id         integer [pk, increment]
  cart_id    integer [not null, ref: > carts.id]
  product_id integer [not null, ref: > products.id]
  quantity   integer [not null, default: 1, note: 'CHECK (quantity > 0); validated against stock by backend']
  unit_price decimal(12,2) [not null, note: 'Price when added - backend re-reads current price at checkout']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    (cart_id, product_id) [unique]
  }
}

// ---------------------------------------------------------------------
// ORDERING
// ---------------------------------------------------------------------

Table orders {
  id                 integer [pk, increment]
  order_number       varchar(30) [unique, not null, note: 'Human-friendly, e.g. BDM-20261006-0001']
  customer_id        integer [not null, ref: > customers.user_id]
  store_id           integer [not null, ref: > stores.id]
  address_id         integer [ref: > addresses.id, note: 'Nullable: address may be deleted later. Snapshot below is authoritative']
  delivery_address   varchar(255) [not null, note: 'SNAPSHOT of address at checkout']
  delivery_phone     varchar(20)  [not null, note: 'SNAPSHOT']
  delivery_latitude  decimal(9,6)
  delivery_longitude decimal(9,6)
  subtotal_amount    decimal(12,2) [not null]
  delivery_fee       decimal(12,2) [not null, default: 0]
  total_amount       decimal(12,2) [not null, note: 'Calculated by backend ONLY = sum(subtotals) + delivery_fee']
  order_status       order_status   [not null, default: 'PENDING']
  payment_status     payment_status [not null, default: 'PENDING', note: 'Mirror of latest payment, updated by webhook']
  notes              text
  status_reason      text [note: 'Why REJECTED or CANCELLED - shown to the customer']
  ordered_at         timestamp [not null, default: `now()`]
  created_at         timestamp [not null, default: `now()`]
  updated_at         timestamp [not null, default: `now()`]

  indexes {
    (store_id, order_status)
    (customer_id, ordered_at)
  }

  Note: 'Status changes ONLY via the backend state machine (no arbitrary transitions). Created atomically with items, stock reduction, payment, history, notification.'
}

Table order_items {
  id         integer [pk, increment]
  order_id   integer [not null, ref: > orders.id]
  product_id integer [not null, ref: > products.id]
  product_name varchar(100) [not null, note: 'SNAPSHOT so history survives product edits']
  unit       product_unit [not null, note: 'SNAPSHOT of the selling unit']
  quantity   integer [not null, note: 'CHECK (quantity > 0)']
  unit_price decimal(12,2) [not null, note: 'Price paid - never changes after order']
  subtotal   decimal(12,2) [not null, note: 'quantity x unit_price']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  indexes {
    order_id
  }
}

Table order_status_history {
  id         integer [pk, increment]
  order_id   integer [not null, ref: > orders.id]
  from_status order_status [note: 'NULL for the first record']
  status     order_status [not null, note: 'New status (to_status)']
  changed_by integer [ref: > users.id, note: 'NULL = system (e.g. payment webhook)']
  changed_at timestamp [not null, default: `now()`]
  notes      text

  indexes {
    (order_id, changed_at)
  }

  Note: 'Append-only audit trail. Powers the customer tracking timeline.'
}

// ---------------------------------------------------------------------
// PAYMENTS
// ---------------------------------------------------------------------

Table payments {
  id                    integer [pk, increment]
  order_id              integer [not null, ref: > orders.id, note: 'Many payments per order allowed (retries)']
  amount                decimal(12,2) [not null]
  payment_method        payment_method [not null]
  payment_status        payment_status [not null, default: 'PENDING']
  transaction_reference varchar(100) [unique, note: 'From gateway. Unique for idempotent webhooks']
  payer_phone           varchar(20) [note: 'Mobile-money number that receives the payment prompt']
  currency              varchar(3) [not null, default: 'TZS']
  gateway_response      jsonb [note: 'Raw webhook payload for audit/debug. Never expose secrets']
  payment_time          timestamp
  created_at            timestamp [not null, default: `now()`]
  updated_at            timestamp [not null, default: `now()`]

  indexes {
    order_id
    payment_status
  }

  Note: 'SUCCESS is set ONLY by a verified server-side webhook, never by a frontend request.'
}

// ---------------------------------------------------------------------
// DELIVERY (v2 - Phase 10)
// ---------------------------------------------------------------------

Table deliveries {
  id                  integer [pk, increment]
  order_id            integer [unique, not null, ref: - orders.id, note: '0..1 delivery per order']
  driver_id           integer [ref: > drivers.user_id]
  delivery_status     delivery_status [not null, default: 'ASSIGNED']
  assigned_at         timestamp
  picked_up_at        timestamp
  out_for_delivery_at timestamp
  delivered_at        timestamp
  delivery_notes      text
  created_at          timestamp [not null, default: `now()`]
  updated_at          timestamp [not null, default: `now()`]

  Note: '[v2] Built in Phase 10. Not used in MVP.'
}

// ---------------------------------------------------------------------
// NOTIFICATIONS
// ---------------------------------------------------------------------

Table notifications {
  id                integer [pk, increment]
  user_id           integer [not null, ref: > users.id]
  order_id          integer [ref: > orders.id]
  notification_type notification_type [not null]
  title             varchar(120) [not null]
  message           text [not null]
  is_read           boolean [not null, default: false]
  created_at        timestamp [not null, default: `now()`]

  indexes {
    (user_id, is_read)
  }

  Note: 'Created inside the same transaction as the event that triggers it.'
}

// ---------------------------------------------------------------------
// TABLE GROUPS (colour/section blocks in dbdiagram.io)
// ---------------------------------------------------------------------

TableGroup identity_access {
  users
  customers
  store_owners
  drivers
}

TableGroup stores_catalog {
  stores
  categories
  products
}

TableGroup customer_data {
  addresses
  carts
  cart_items
}

TableGroup ordering_payments {
  orders
  order_items
  order_status_history
  payments
}

TableGroup delivery_v2 {
  deliveries
}

TableGroup messaging {
  notifications
}
