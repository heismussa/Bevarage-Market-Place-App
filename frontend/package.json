{
  "name": "beverage-marketplace-frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "customer-app",
    "owner-dashboard"
  ],
  "scripts": {
    "install:check": "npm ls --workspaces --depth=0",
    "build": "npm run build --workspaces --if-present",
    "dev:owner": "npm run dev --workspace=@beverage/owner-dashboard",
    "dev:customer": "npm run dev --workspace=@beverage/customer-app",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspace=@beverage/customer-app && npm run typecheck --workspace=@beverage/owner-dashboard"
  },
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
