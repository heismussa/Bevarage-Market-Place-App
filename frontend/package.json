{
  "name": "beverage-marketplace-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "customer-app",
    "owner-dashboard"
  ],
  "scripts": {
    "gen:api": "openapi-typescript ../docs/openapi.yaml -o packages/api/src/schema.d.ts",
    "lint": "eslint packages owner-dashboard/src --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:owner": "npm run dev --workspace=@beverage/owner-dashboard",
    "dev:customer": "npm run start --workspace=@beverage/customer-app"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "openapi-typescript": "^7.9.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  }
}
